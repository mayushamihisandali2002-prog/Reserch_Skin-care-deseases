# ============================================================================
# SKIN CARE ASSISTANT - BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your values

# Environment mode: development | production
FLASK_ENV=development
FLASK_DEBUG=true

# Server configuration
HOST=0.0.0.0
# The frontend defaults to http://localhost:5001 in development.
PORT=5001

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# Frontend can use either SUPABASE_ANON_KEY or SUPABASE_PUBLISHABLE_KEY.
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# Backend accepts either SUPABASE_SECRET_KEY or SUPABASE_SERVICE_KEY.
SUPABASE_SECRET_KEY=your_service_role_key_here
# Optional alias if your local setup already uses this variable name.
# SUPABASE_SERVICE_KEY=your_service_role_key_here

# Optional: used by backend/tools/pilot/pilot_self_check_v1.py
SUPABASE_ANON_KEY=your_publishable_or_anon_key_here
PILOT_EMAIL=test@skincare.app
PILOT_PASSWORD=Test123456

# Model Configuration
ENABLE_DISTILBERT=true
ENABLE_RESNET=true

# AI Expert Reasoning (Cloud)
# Priority 1: Groq (FREE, super fast!) - Get from https://console.groq.com/
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Priority 2: Gemini (for image analysis) - Get from https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_key_here

# Logging
LOG_LEVEL=DEBUG
